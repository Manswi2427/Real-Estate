# Django Application Settings
SECRET_KEY=generate-a-secure-random-secret-key-for-production
DEBUG=False

# Host & Domain Settings (Railway automatically sets RAILWAY_PUBLIC_DOMAIN when generating a domain)
RAILWAY_PUBLIC_DOMAIN=your-app-name.up.railway.app
ALLOWED_HOSTS=.railway.app,.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app

# Database Configuration (Railway PostgreSQL Service)
# OPTION 1: Discrete Environment Variables (Zero URL, uses Railway variable references)
PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}
PGDATABASE=${{Postgres.PGDATABASE}}

# OPTION 2: Railway Reference Variable
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Email Settings (for Saved Search Alerts)
# By default, console email backend is used when DEBUG=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=RealEstatePortal Alerts <no-reply@estateportal.com>

